# Castlane CRM configuration. Copy to .env for local development.
# Values here are illustrative placeholders — never real secrets.

NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# PostgreSQL (application role must NOT be a superuser)
DATABASE_URL=postgres://castlane:castlane@127.0.0.1:5432/castlane_dev
DATABASE_POOL_MAX=10
# Give up waiting for a free pool connection after this many ms (the request fails instead of hanging)
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=15000
# Per-process access snapshot cache; entries are invalidated by the database access revision, the TTL is a backstop (0 disables)
ACCESS_CACHE_TTL_MS=30000

# Secrets: 32+ random characters each (e.g. `openssl rand -base64 48`). Different per environment.
SESSION_SECRET=replace-with-random-48-bytes-base64-value-000000
MFA_ENCRYPTION_KEY=replace-with-different-random-48-bytes-value-00
# Optional password pepper (HMAC applied before Argon2id). Changing it invalidates all passwords.
PASSWORD_PEPPER=

# Object storage: "filesystem" for local development, "s3" for staging/production (private bucket)
STORAGE_DRIVER=filesystem
STORAGE_FS_ROOT=./var/storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PRIVATE=castlane-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=5368709120

# Malware scanning: "clamd" (required in production) or "disabled-dev-only"
SCANNER_MODE=disabled-dev-only
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Optional media tools for video/audio metadata and previews
FFPROBE_PATH=
FFMPEG_PATH=

# Mail: "smtp" (required in production) or "dev_sink" (local mailbox, nothing is delivered).
# The SMTP server can be set here or entered in Settings → Workspace → Mail (the saved server wins;
# its password is encrypted with SECRETS_ENCRYPTION_KEY and never shown again).
MAIL_TRANSPORT=dev_sink
SECRETS_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Castlane <no-reply@example.invalid>"

# Worker
JOB_CONCURRENCY=4
# Analytics read model: recompute a stale dashboard at most this often, and every dashboard at least this often
ANALYTICS_SNAPSHOT_MIN_REFRESH_SECONDS=300
ANALYTICS_SNAPSHOT_MAX_AGE_SECONDS=21600
MEDIA_JOB_CONCURRENCY=1

# Reverse proxy: set true only behind a trusted proxy that sets X-Forwarded-For
TRUST_PROXY=false
LOG_LEVEL=info

# Optional internal endpoint reporting backup/restore-drill status (see docs/runbooks/backup-restore.md)
BACKUP_STATUS_ENDPOINT_INTERNAL=
