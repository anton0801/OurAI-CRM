# Copy to infra/.env.compose and replace every value. Never commit the real file.
CASTLANE_VERSION=local
APP_ORIGIN=https://crm.example.com
POSTGRES_OWNER_PASSWORD=replace-me-owner-password
POSTGRES_APP_PASSWORD=replace-me-app-password
SESSION_SECRET=replace-with-random-48-bytes-base64-value-000000
MFA_ENCRYPTION_KEY=replace-with-different-random-48-bytes-value-00
PASSWORD_PEPPER=
# Managed S3: its endpoint. Bundled store (--profile local-s3): http://s3:8333 and copy
# infra/seaweedfs/s3.json.example to infra/seaweedfs/s3.json with the same credentials.
STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
STORAGE_REGION=eu-central-1
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=replace-me-storage-user
STORAGE_SECRET_ACCESS_KEY=replace-me-storage-secret-min-8
STORAGE_BUCKET_PRIVATE=castlane-private
# Optional: the SMTP server can instead be entered in Settings → Workspace → Mail (encrypted with this key).
SECRETS_ENCRYPTION_KEY=replace-with-a-third-random-48-bytes-value-000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Castlane <no-reply@example.com>"

CASTLANE_SITE_ADDRESS=crm.example.com
