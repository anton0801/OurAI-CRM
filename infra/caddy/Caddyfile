# Production TLS-terminating reverse proxy. Caddy obtains and renews a public certificate for
# CASTLANE_SITE_ADDRESS automatically (ports 80/443 must reach this host).
{$CASTLANE_SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		# Upload parts are 8 MiB; keep headroom for multipart overhead.
		max_size 64MB
	}
	# Three web processes (infra/docker-compose.yml web-1..3). Active health checks take a process
	# out of rotation while it is down or not ready (database unreachable); requests are retried on
	# another process for up to 5 s. Sticky cookie: a browser stays on one process, so per-process
	# API rate limits and caches behave per member as with a single process; it moves only on failure.
	reverse_proxy web-1:3000 web-2:3000 web-3:3000 {
		lb_policy cookie castlane_upstream
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /api/v1/health/ready
		health_interval 10s
		health_timeout 3s
		health_status 2xx
		fail_duration 30s
		# Server-sent events: never buffer.
		flush_interval -1
	}
}
